# Copy to .env (git ignores it) and fill in. Used by scripts/*.py locally.
SNOWFLAKE_ACCOUNT=xy12345.west-europe.azure      # Snowsight: Admin > Accounts > account identifier
SNOWFLAKE_USER=YOUR_USER
SNOWFLAKE_ROLE=S2C_ADMIN
SNOWFLAKE_WAREHOUSE=S2C_WH
SNOWFLAKE_DATABASE=S2C_DEV

# pick ONE way to log in
SNOWFLAKE_PRIVATE_KEY_PATH=~/.ssh/snowflake/rsa_key.p8
# SNOWFLAKE_PRIVATE_KEY_PASSPHRASE=
# SNOWFLAKE_PASSWORD=
# SNOWFLAKE_AUTHENTICATOR=externalbrowser

# pre-load volume check tolerance (+/- 30 %)
VOLUME_TOLERANCE=0.30
